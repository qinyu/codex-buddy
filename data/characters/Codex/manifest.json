{
  "name": "Codex",
  "mode": "text",
  "colors": {
    "body": "#FFFFFF",
    "bg": "#000000",
    "text": "#FFFFFF",
    "textDim": "#808080",
    "ink": "#000000"
  },
  "states": {
    "sleep": {"delay": 400, "frames": ["C."]},
    "idle": {"delay": 300, "frames": ["Codex"]},
    "busy": {"delay": 180, "frames": ["Codex*", "Codex"]},
    "attention": {"delay": 160, "frames": ["!Codex!", "Codex"]},
    "completed": {"delay": 220, "frames": ["Codex+", "Codex"]},
    "celebrate": {"delay": 180, "frames": ["*Codex*", "Codex"]},
    "dizzy": {"delay": 120, "frames": ["@Codex", "Codex"]},
    "heart": {"delay": 200, "frames": ["<Codex>", "Codex"]}
  }
}
