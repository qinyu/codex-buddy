{
  "name": "Cursor",
  "mode": "text",
  "colors": {
    "body": "#FFFFFF",
    "bg": "#000000",
    "text": "#FFFFFF",
    "textDim": "#808080",
    "ink": "#000000"
  },
  "states": {
    "sleep": {"delay": 400, "frames": ["C."]},
    "idle": {"delay": 300, "frames": ["Cursor"]},
    "busy": {"delay": 180, "frames": ["Cursor*", "Cursor"]},
    "attention": {"delay": 160, "frames": ["!Cursor!", "Cursor"]},
    "completed": {"delay": 220, "frames": ["Cursor+", "Cursor"]},
    "celebrate": {"delay": 180, "frames": ["*Cursor*", "Cursor"]},
    "dizzy": {"delay": 120, "frames": ["@Cursor", "Cursor"]},
    "heart": {"delay": 200, "frames": ["<Cursor>", "Cursor"]}
  }
}
